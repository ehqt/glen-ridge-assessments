#!/usr/bin/env python3
"""Extract one municipality's rate/levy row from DCA Property Tax Tables.

Usage:
    python rates_ingest.py --raw-dir ../data/raw/rates \
        --municipality "Glen Ridge" --out ../data/rates.csv

Handles vintage drift across 1998-present workbooks:
- sheet name varies ('A', 'YYYY Taxes', 'Municipal Tax Summary')
- header row varies (row 0 or 1)
- column names vary ('1998 Total Rate' vs 'CY Total Rate', etc.)
- some files hold ONE year (year comes from the filename, 98taxes.xls -> 1998);
  others are combined files holding MANY years in a 'Year' column. Both work.
"""
import argparse
import csv
import glob
import os
import re
import sys

import pandas as pd

# ordered alternatives: first match wins
COLMAP = {
    "net_valuation_taxable": ["net valuation taxable", "net  valuation taxable"],
    "total_levy":            ["total levy on which tax rate is computed", "total tax levy"],
    "county_levy":           ["total county levy"],
    "school_levy":           ["total school levy"],
    "municipal_levy":        ["total local municipal tax levy", "total local municipal levy"],
    "general_tax_rate":      ["cy total rate", "total rate"],  # 'YYYY Total Rate' via year-strip
    "equalization_ratio_pct": ["state equalization table average ratio",
                               "state equalization table ratio"],
    "equalized_value":       ["cy equalized property value (pre-appeal)", "cy equalized value",
                              "equalized value"],
}


def year_from_filename(path):
    m = re.match(r"(\d{2})taxes", os.path.basename(path).lower())
    if not m:
        return None
    yy = int(m.group(1))
    return 2000 + yy if yy < 50 else 1900 + yy


def pick_sheet(xl):
    for s in xl.sheet_names:
        if "municipal tax summary" in s.lower():
            return s
    for s in xl.sheet_names:
        if "taxes" in s.lower() or s.strip() == "A":
            return s
    return xl.sheet_names[0]


def normalize(col, year):
    c = str(col).replace("\n", " ").strip().lower()
    c = re.sub(r"\s+", " ", c)
    c = re.sub(r"\(col\.? ?\d+\)", "", c).strip()       # drop '(Col. 6)'
    c = re.sub(rf"^{year} ", "cy ", c)                   # '1998 Total Rate' -> 'cy total rate'
    return c


def find_name_col(df):
    """Locate the municipality-name column by header text, not position.

    Columns arrive already normalized (lowercased, whitespace collapsed) from
    normalize(). Accepts singular or plural; falls back to any header whose
    words include 'municipality'/'municipalities' (e.g. 'municipality name').
    """
    cols = list(df.columns)
    for want in ("municipalities", "municipality"):
        if want in cols:
            return want
    for c in cols:
        words = set(str(c).split())
        if words & {"municipality", "municipalities"}:
            return c
    return None


def find_header_row(df):
    for i in range(min(5, len(df))):
        row = " ".join(str(v).lower() for v in df.iloc[i].tolist())
        if "municode" in row.replace("-", "") or "muni-" in row:
            return i
    return 0


def find_year_col(df):
    """Find a per-row tax-year column in combined multi-year workbooks."""
    for c in df.columns:
        if str(c).strip() in ("year", "tax year", "calendar year"):
            return c
    return None


def read_with_header(path, sheet, hdr, year):
    """Read the sheet using row `hdr` as the header, normalizing column names."""
    df = pd.read_excel(path, sheet_name=sheet, engine=None, header=hdr)
    df.columns = [normalize(c, year) for c in df.columns]
    return df


def extract(path, municipality):
    """Return a list of per-year dicts for `municipality` from one workbook."""
    year = year_from_filename(path)  # may be None for combined multi-year files
    xl = pd.ExcelFile(path, engine=None)
    sheet = pick_sheet(xl)
    probe = pd.read_excel(path, sheet_name=sheet, engine=None, header=None, nrows=5)
    hdr = find_header_row(probe)
    df = read_with_header(path, sheet, hdr, year)

    # Locate the municipality column by header text. Some vintages carry a
    # title/banner row above the real headers, so if the column isn't found,
    # discard that first row and treat the next one as the header instead.
    name_col = find_name_col(df)
    if name_col is None:
        retry = read_with_header(path, sheet, hdr + 1, year)
        retry_col = find_name_col(retry)
        if retry_col is not None:
            print(f"note {os.path.basename(path)}: headers found on row "
                  f"{hdr + 2}, not row {hdr + 1}")
            df, name_col = retry, retry_col
    if name_col is None:
        print(f"WARN {path}: no 'Municipality'/'Municipalities' column found "
              f"on row {hdr + 1} or {hdr + 2}; columns were "
              f"{list(df.columns)[:6]}...", file=sys.stderr)
        return []

    hits = df[df[name_col].astype(str).str.contains(municipality, case=False, na=False)]
    if hits.empty:
        print(f"WARN {path}: no rows match {municipality!r}", file=sys.stderr)
        return []

    # Combined workbooks carry one row per year; single-year workbooks carry
    # one row total and take their year from the filename.
    year_col = find_year_col(df)
    if year_col is None:
        if year is None:
            print(f"WARN {path}: no 'Year' column and no year in the filename; "
                  f"cannot date these rows", file=sys.stderr)
            return []
        if len(hits) > 1:
            print(f"WARN {path}: {len(hits)} rows match {municipality!r} for a "
                  f"single year; using the first", file=sys.stderr)
        hits = hits.head(1)

    out_rows = []
    for _, row in hits.iterrows():
        row_year = year
        if year_col is not None:
            try:
                row_year = int(float(str(row[year_col]).strip()))
            except (TypeError, ValueError):
                continue  # skip subtotal/blank rows
        out = {"year": row_year, "source_file": os.path.basename(path)}
        for field, alts in COLMAP.items():
            val = None
            for alt in alts:
                if alt in df.columns:
                    val = row[alt]
                    break
            out[field] = None if pd.isna(val) else val
        if out["equalization_ratio_pct"] is not None:
            out["equalization_ratio"] = round(float(out["equalization_ratio_pct"]) / 100, 6)
        else:
            out["equalization_ratio"] = None
        if out["general_tax_rate"] is not None:
            out["general_tax_rate"] = round(float(out["general_tax_rate"]), 4)
        out_rows.append(out)
    return out_rows


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--raw-dir", required=True)
    ap.add_argument("--municipality", required=True)
    ap.add_argument("--out", required=True)
    args = ap.parse_args()

    paths = sorted(
        p for p in glob.glob(os.path.join(args.raw_dir, "*"))
        if p.lower().endswith((".xls", ".xlsx", ".xlsm"))
        and not os.path.basename(p).startswith("~$")
    )
    if not paths:
        sys.exit(f"no Excel files in {args.raw_dir}")
    rows = []
    for p in paths:
        rows.extend(extract(p, args.municipality) or [])

    # Later files win if two sources cover the same year.
    by_year = {}
    for r in rows:
        by_year[r["year"]] = r
    rows = sorted(by_year.values(), key=lambda r: r["year"])

    fields = ["year", "general_tax_rate", "equalization_ratio", "reval_flag",
              "total_levy", "county_levy", "school_levy", "municipal_levy",
              "net_valuation_taxable", "equalized_value", "rate_is_implied",
              "source_file"]
    with open(args.out, "w", newline="") as f:
        w = csv.DictWriter(f, fieldnames=fields)
        w.writeheader()
        for r in rows:
            r.setdefault("reval_flag", "")
            r.setdefault("rate_is_implied", "false")
            w.writerow({k: r.get(k, "") for k in fields})
    print(f"wrote {args.out}: {len(rows)} years "
          f"({', '.join(str(r['year']) for r in rows)})")


if __name__ == "__main__":
    main()
